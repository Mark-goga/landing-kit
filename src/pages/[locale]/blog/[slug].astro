---
import { getCollection, type CollectionEntry } from "astro:content";
import GeneratedBlogArticleLayout from "../../../layouts/GeneratedBlogArticleLayout.astro";
import { translationsByGroup } from "../../../lib/blog-translations";

type Props = {
  entry: CollectionEntry<"blog">;
  translations: CollectionEntry<"blog">[];
};

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const translationsOf = translationsByGroup(all);

  return all
    .filter((entry: CollectionEntry<"blog">) => entry.data.locale !== "en")
    .map((entry: CollectionEntry<"blog">) => ({
      params: { locale: entry.data.locale, slug: entry.data.slug },
      props: { entry, translations: translationsOf(entry) } satisfies Props,
    }));
}

const { entry, translations } = Astro.props as Props;
---

<GeneratedBlogArticleLayout entry={entry} translations={translations} />
