---
interface Props {
  heading: string;
  body: string;
  actionLabel: string;
  href: string;
}

const { heading, body, actionLabel, href } = Astro.props;
---

<aside class="article-midcta" aria-label={heading}>
  <div class="article-midcta__body">
    <p class="article-midcta__heading">{heading}</p>
    <p class="article-midcta__text">{body}</p>
  </div>
  <a class="article-midcta__button article-cta-button" href={href} target="_blank" rel="noopener">
    {actionLabel}
    <span aria-hidden="true" class="article-midcta__arrow">→</span>
  </a>
</aside>

<style is:global>
  .article-midcta {
    margin: 2.5rem 0;
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--article-callout-surface, var(--article-accent-tint, rgba(76, 39, 227, 0.06)));
    border: 1px solid var(--article-border, rgba(14, 14, 14, 0.12));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .article-midcta__body {
    flex: 1 1 55%;
    min-width: min(100%, 16rem);
  }

  .article-midcta__heading {
    font-family: inherit;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--article-heading, #0E0E0E);
    margin: 0 0 0.25rem !important;
    letter-spacing: -0.01em;
  }

  .article-midcta__text {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--article-text-secondary, #3D3D3D);
    margin: 0 !important;
  }

  .article-midcta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border-radius: 8px;
    background: var(--article-accent, #4C27E3);
    color: #ffffff;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .article-midcta__button:hover {
    background: var(--article-accent-hover, #3D1FB6);
  }

  .article-midcta__button:active {
    transform: translateY(1px);
  }

  .article-midcta__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .article-midcta__button:hover .article-midcta__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .article-midcta {
      padding: 1.1rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
    }
    .article-midcta__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
