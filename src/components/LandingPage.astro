---
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Why from "./Why.astro";
import Features from "./Features.astro";
import Pricing from "./Pricing.astro";
import Faq from "./Faq.astro";
import Cta from "./Cta.astro";
import Footer from "./Footer.astro";
import LeadModal from "./LeadModal.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
import { siteConfig, type LocaleKey } from "../config/site";
import { landingContent, landingLanguageNav } from "@site/data/locales";

interface Props {
  locale: LocaleKey;
  canonicalPath?: string;
  routePath?: string;
  storeLinks?: { appStore: string; googlePlay: string };
}

const { locale, canonicalPath, routePath, storeLinks } = Astro.props;
const content = landingContent[locale];
const pageCanonicalPath = canonicalPath ?? content.path;
const pageRoutePath = routePath ?? content.path;
---

<LandingLayout content={content} canonicalPath={pageCanonicalPath} routePath={pageRoutePath}>
  <Header content={content} routePath={pageRoutePath} languageNav={landingLanguageNav()} />
  <main>
    <Hero content={content} routePath={pageRoutePath} />
    <Why content={content} routePath={pageRoutePath} />
    <Features content={content} routePath={pageRoutePath} />
    <Pricing content={content} routePath={pageRoutePath} />
    <Faq content={content} />
    <Cta content={content} />
  </main>
  <Footer content={content} routePath={pageRoutePath} />
  <LeadModal content={content} routePath={pageRoutePath} storeLinks={storeLinks} />
</LandingLayout>

