---
import { absoluteUrl } from "../config/site";

export interface BreadcrumbItem {
  label: string;
  href?: string; // last item usually omits href
}

interface Props {
  items: BreadcrumbItem[];
  ariaLabel?: string;
  truncateLast?: number;
}

const { items, ariaLabel = "Breadcrumb", truncateLast } = Astro.props;

const trim = (s: string, max: number) =>
  s.length <= max ? s : s.slice(0, max - 1).trimEnd() + "…";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: absoluteUrl(item.href) } : {}),
  })),
};
---

<nav class="crumb" aria-label={ariaLabel}>
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current={index === items.length - 1 ? "page" : undefined} title={item.label}>
            {index === items.length - 1 && truncateLast ? trim(item.label, truncateLast) : item.label}
          </span>
        )}
        {index < items.length - 1 && (
          <svg class="sep" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .crumb {
    font-family: "Roboto Flex", system-ui, -apple-system, sans-serif;
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--article-text-muted, #6b6975);
    line-height: 1;
  }
  .crumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .crumb li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .crumb a {
    color: inherit;
    text-decoration: none;
    padding: 4px 6px;
    margin: -4px -6px;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .crumb a:hover {
    color: var(--article-accent, #4c27e3);
    background: var(--article-hover-bg, rgba(76, 39, 227, 0.08));
  }
  .crumb .sep {
    color: var(--article-border-strong, #cbc9d4);
    flex-shrink: 0;
  }
  .crumb [aria-current="page"] {
    color: var(--article-heading, #16151a);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60ch;
  }
</style>
