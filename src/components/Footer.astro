---
import { pageAssetUrl } from "../config/site";
import { brandTokens } from "@site/config/brand";
import type { LandingContent } from "@site/data/locales";

// Optional extras a landing may add to `content.footer`; landings without them
// render exactly as before.
type FooterExtras = {
  tagline?: string;
  stores?: { label: string; href: string; icon: string }[];
};

interface Props {
  content: LandingContent;
  routePath: string;
}

const { content, routePath } = Astro.props;
const logo = pageAssetUrl(routePath, brandTokens.footerLogoPath ?? "assets/LOGOFLUXOBlack.png");
const { tagline, stores = [] } = content.footer as LandingContent["footer"] & FooterExtras;
const tiktok = pageAssetUrl(routePath, "assets/TiktokLogo.svg");
const linkedin = pageAssetUrl(routePath, "assets/basil_linkedin-outline.svg");
const resolveFooterHref = (href: string) => (href.startsWith("#") && href.length > 1 ? `${content.path}${href}` : href);
---

<footer class="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <img src={logo} alt={content.footer.brandAlt} />
      {tagline && <p class="footer-tagline">{tagline}</p>}
      {
        stores.length > 0 && (
          <div class="footer-stores">
            {stores.map((store) => (
              <a
                href={resolveFooterHref(store.href)}
                class="footer-store-btn"
                aria-label={store.label}
                data-footer-store
                data-store-label={store.label}
              >
                <img src={pageAssetUrl(routePath, store.icon)} alt="" aria-hidden="true" />
              </a>
            ))}
          </div>
        )
      }
      <div class="footer-socials">
        {
          content.footer.socials.map((social) => (
            <a href={social.href} class="footer-social-btn" aria-label={social.label}>
              {social.label === "TikTok" && <img src={tiktok} alt="" aria-hidden="true" />}
              {social.label === "X" && <img src={linkedin} alt="" aria-hidden="true" />}
              {social.label === "Instagram" && (
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="15" height="15" rx="4" stroke="white" stroke-width="1.4" />
                  <circle cx="10" cy="10" r="3.5" stroke="white" stroke-width="1.4" />
                  <circle cx="14.25" cy="5.75" r="1" fill="white" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
    <div class="footer-cols">
      {
        content.footer.columns.map((column) => (
          <div class="footer-col">
            <div class="footer-col-title">{column.title}</div>
            <ul class="footer-links">
              {column.links.map((link) => (
                <li>
                  <a href={resolveFooterHref(link.href)} data-footer-store-link>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">{content.footer.copyright}</span>
    <button type="button" class="footer-consent" onclick="window.displayPreferenceModal && window.displayPreferenceModal()">
      {content.footer.consentPreferences}
    </button>
  </div>
</footer>

<script>
  (() => {
    // Platform detection
    const iOS_PATTERN = /iPad|iPhone|iPod/;
    const ANDROID_PATTERN = /Android/;

    const detectPlatform = () => {
      if (typeof navigator === "undefined") return "desktop";
      const ua = navigator.userAgent;
      if (iOS_PATTERN.test(ua)) return "ios";
      if (ANDROID_PATTERN.test(ua)) return "android";
      return "desktop";
    };

    // Store label keywords (case-insensitive)
    const APPLE_KEYWORDS = ["app store", "appstore"];
    const GOOGLE_KEYWORDS = ["google play", "googleplay", "play store", "playmarket", "play market"];

    const isAppleStore = (label: string) => {
      const l = label.toLowerCase();
      return APPLE_KEYWORDS.some((k) => l.includes(k));
    };

    const isGooglePlay = (label: string) => {
      const l = label.toLowerCase();
      return GOOGLE_KEYWORDS.some((k) => l.includes(k));
    };

    // Read store links from the modal's store buttons (set at build time)
    const modal = document.querySelector("[data-lead-modal]");
    const storeContainer = modal?.querySelector("[data-modal-stores]");
    const storeBtns = storeContainer?.querySelectorAll("[data-store-link]");
    let appStoreUrl = "";
    let googlePlayUrl = "";
    storeBtns?.forEach((btn) => {
      if ((btn as HTMLElement).dataset.storeLink === "appstore") {
        appStoreUrl = (btn as HTMLAnchorElement).href;
      }
      if ((btn as HTMLElement).dataset.storeLink === "googleplay") {
        googlePlayUrl = (btn as HTMLAnchorElement).href;
      }
    });

    const getStoreUrlForPlatform = (platform: string, label: string) => {
      if (platform === "ios") return appStoreUrl;
      if (platform === "android") return googlePlayUrl;
      return null;
    };

    const track = (name: string, params: object) => {
      if (typeof window.fluxoTrack === "function") window.fluxoTrack(name, params || {});
    };

    // Handle footer store icon buttons
    document.querySelectorAll("[data-footer-store]").forEach((el) => {
      (el as HTMLAnchorElement).addEventListener("click", (e) => {
        const platform = detectPlatform();
        const label = (el as HTMLElement).dataset.storeLabel || "";
        let url: string | null = null;

        if (platform !== "desktop") {
          // On mobile, redirect to the matching store
          if (isAppleStore(label) && platform === "ios") {
            url = appStoreUrl || null;
          } else if (isGooglePlay(label) && platform === "android") {
            url = googlePlayUrl || null;
          }
          // If the button doesn't match the platform, still follow the original link
          // (it already points to the correct store from locales.ts)
        }

        if (url) {
          e.preventDefault();
          track("footer_store_click", { from: "footer-store-icon", platform, label });
          window.location.href = url;
        }
      });
    });

    // Handle footer column text links (App Store / Google Play)
    document.querySelectorAll("[data-footer-store-link]").forEach((el) => {
      (el as HTMLAnchorElement).addEventListener("click", (e) => {
        const label = (el as HTMLElement).textContent || "";
        const platform = detectPlatform();

        if (platform !== "desktop") {
          let url: string | null = null;
          if (isAppleStore(label)) {
            url = platform === "ios" ? appStoreUrl : null;
          } else if (isGooglePlay(label)) {
            url = platform === "android" ? googlePlayUrl : null;
          }

          if (url) {
            e.preventDefault();
            track("footer_store_click", { from: "footer-column", platform, label });
            window.location.href = url;
            return;
          }
          // If user clicks "App Store" on Android (or vice versa), open the modal
          if ((isAppleStore(label) || isGooglePlay(label)) && !url) {
            e.preventDefault();
            track("footer_store_click", { from: "footer-column", platform, label, action: "open_modal" });
            const openBtn = document.querySelector("[data-modal-open]");
            if (openBtn instanceof HTMLElement) openBtn.click();
            return;
          }
        }
        // Desktop: follow the original link (which points to the store)
      });
    });
  })();
</script>
