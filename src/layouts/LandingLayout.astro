---
import { absoluteUrl, pageAssetUrl, siteConfig, supportedLocales, xDefaultPath } from "../config/site";
import type { LandingContent } from "@site/data/locales";
import SeoHead from "../components/SeoHead.astro";
import TrackingScripts from "../components/TrackingScripts.astro";
import TurnstileScript from "../components/TurnstileScript.astro";
import "@site/styles/styles.css";

interface Props {
  content: LandingContent;
  canonicalPath: string;
  routePath: string;
}

const { content, canonicalPath, routePath } = Astro.props;
const canonicalUrl = absoluteUrl(canonicalPath);
const heroImageUrl = absoluteUrl(siteConfig.heroImagePath);
const heroImagePath = pageAssetUrl(routePath, siteConfig.heroImagePath);
const scriptPath = pageAssetUrl(routePath, siteConfig.scriptPath);

const alternates = [
  ...supportedLocales.map((locale) => ({
    hreflang: locale.hreflang,
    href: absoluteUrl(locale.path),
  })),
  { hreflang: "x-default", href: absoluteUrl(xDefaultPath) },
];

const rssHref =
  content.lang === "en"
    ? absoluteUrl("/blog/rss.xml")
    : absoluteUrl(`/${content.lang}/blog/rss.xml`);

const structured = content.structuredData;
const searchAction = structured.searchUrlTemplate
  ? {
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: absoluteUrl(structured.searchUrlTemplate),
        },
        "query-input": "required name=search_term_string",
      },
    }
  : {};

const websiteJson = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  description: structured.description,
  url: canonicalUrl,
  inLanguage: content.lang,
  ...searchAction,
};

const organizationJson = structured.organization
  ? {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: siteConfig.name,
      url: absoluteUrl("/"),
      logo: absoluteUrl(structured.organization.logoPath),
      ...(structured.organization.sameAs?.length
        ? { sameAs: structured.organization.sameAs }
        : {}),
      ...(structured.organization.contactEmail
        ? {
            contactPoint: {
              "@type": "ContactPoint",
              email: structured.organization.contactEmail,
              contactType: "customer support",
            },
          }
        : {}),
    }
  : null;

const softwareJson = structured.software
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: siteConfig.name,
      description: structured.description,
      url: canonicalUrl,
      inLanguage: content.lang,
      applicationCategory: structured.software.category,
      operatingSystem: structured.software.operatingSystem,
      ...(structured.software.offers?.length
        ? {
            offers: structured.software.offers.map((offer) => ({
              "@type": "Offer",
              name: offer.name,
              price: offer.price,
              priceCurrency: offer.priceCurrency,
              ...(offer.description ? { description: offer.description } : {}),
            })),
          }
        : {}),
      ...(structured.software.aggregateRating
        ? {
            aggregateRating: {
              "@type": "AggregateRating",
              ratingValue: structured.software.aggregateRating.ratingValue,
              ratingCount: structured.software.aggregateRating.ratingCount,
            },
          }
        : {}),
    }
  : null;

const faqJson = content.faq?.items?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: content.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <TrackingScripts />
    <TurnstileScript />
    <SeoHead
      title={content.meta.title}
      description={content.meta.description}
      canonicalUrl={canonicalUrl}
      routePath={routePath}
      lang={content.lang}
      alternates={alternates}
      openGraphType="website"
      openGraphTitle={content.meta.ogTitle}
      openGraphDescription={content.meta.ogDescription}
      openGraphImage={heroImageUrl}
      openGraphImageAlt={content.hero.imageAlt}
      openGraphImageWidth={1200}
      openGraphImageHeight={630}
      openGraphImageType="image/png"
      openGraphLocale={content.ogLocale}
      openGraphLocaleAlternates={content.ogLocaleAlternate ? [content.ogLocaleAlternate] : []}
      twitterTitle={content.meta.twitterTitle}
      twitterDescription={content.meta.twitterDescription}
      twitterImage={heroImageUrl}
      rssHref={rssHref}
      preloads={[{ href: heroImagePath, as: "image" }]}
    />

    <script type="application/ld+json" set:html={JSON.stringify(websiteJson)}></script>
    {organizationJson && (
      <script type="application/ld+json" set:html={JSON.stringify(organizationJson)}></script>
    )}
    {softwareJson && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareJson)}></script>
    )}
    {faqJson && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
    )}
  </head>
  <body>
    <slot />
    <script src={scriptPath} defer></script>
  </body>
</html>
