---
import { getEntry, render, getCollection, type CollectionEntry } from "astro:content";
import PageLayout from "./PageLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Modal from "../components/Modal.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import KeepReading from "../components/KeepReading.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { siteConfig, pageAssetUrl, absoluteUrl, supportedLocales, type LocaleKey } from "../config/site";
import { landingContent, localeMeta, type LanguageOption } from "@site/data/locales";
import { withBrandSuffix } from "../lib/page-title";

interface Props {
  slug: string;
  locale?: LocaleKey;
}

const { slug, locale = "en" } = Astro.props;

const entry = await getEntry("blogStatic", `${locale}/${slug}`);
if (!entry) {
  throw new Error(`Unknown blog article "${slug}" for locale "${locale}"`);
}

const article = entry.data;
const { Content, headings } = await render(entry);
const authorObj = article.author;
const authorName = authorObj.name;
const authorBioEntry = authorObj.bio.find((b) => b.locale === locale) ?? authorObj.bio.find((b) => b.locale === "en");

const content = landingContent[locale];
const routePath = article.routePath;
const heroImage = pageAssetUrl(routePath, article.heroAsset);

const allStatic = await getCollection("blogStatic");
const bySlug = allStatic.filter((e: CollectionEntry<"blogStatic">) => e.data.slug === slug);
const languageNav: LanguageOption[] = supportedLocales.map((opt) => {
  const match = bySlug.find((e) => e.data.locale === opt.key);
  const href = (match ?? bySlug.find((e) => e.data.locale === "en"))?.data.routePath ?? routePath;
  return { locale: opt.key, href, code: localeMeta[opt.key].code, name: localeMeta[opt.key].name };
});
type AlternateLink = { hreflang: string; href: string };

const alternates: AlternateLink[] = supportedLocales
  .map((opt): AlternateLink | null => {
    const match = bySlug.find((e) => e.data.locale === opt.key);
    if (!match) return null;
    return { hreflang: opt.hreflang, href: absoluteUrl(match.data.routePath) };
  })
  .filter((alternate): alternate is AlternateLink => alternate !== null);
const enEntry = bySlug.find((e) => e.data.locale === "en") ?? entry;
alternates.push({ hreflang: "x-default", href: absoluteUrl(enEntry.data.routePath) });

const heroAssetAbsolute = absoluteUrl(`/${article.heroAsset.replace(/^\/+/, "")}`);
const ogCoverPath = locale === "en"
  ? `/assets/covers/${slug}.png`
  : `/assets/covers/${slug}-${locale}.png`;
const ogCoverAbsolute = absoluteUrl(ogCoverPath);

const publishedDate = new Date(`${article.publishedAt}T09:00:00Z`);
const publishedIso = publishedDate.toISOString();
const modifiedIso = article.modifiedAt
  ? new Date(`${article.modifiedAt}T09:00:00Z`).toISOString()
  : publishedIso;
const pageTitle = withBrandSuffix(article.metaTitle, siteConfig.name);
const readTimeMinutes = Number.parseInt(article.readTime, 10);
const timeRequired = Number.isSafeInteger(readTimeMinutes) && readTimeMinutes > 0
  ? `PT${readTimeMinutes}M`
  : undefined;

const dateLocaleMap: Record<LocaleKey, string> = {
  en: "en-US",
  uk: "uk-UA",
  es: "es-ES",
  de: "de-DE",
};
const publishedDisplay = publishedDate.toLocaleDateString(dateLocaleMap[locale] ?? "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.metaDescription,
  image: [heroAssetAbsolute, ogCoverAbsolute],
  datePublished: publishedIso,
  dateModified: modifiedIso,
  ...(timeRequired ? { timeRequired } : {}),
  mainEntityOfPage: absoluteUrl(routePath),
  inLanguage: locale,
  author: {
    "@type": "Person",
    name: authorName,
    ...(authorObj.links.website ? { url: authorObj.links.website } : {}),
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: absoluteUrl("/"),
  },
};

const faqSchema = article.faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: article.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;

const blogHref = locale === "en" ? "/blog/" : `/${locale}/blog/`;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: content.blog.ui.breadcrumbHome,
      item: absoluteUrl(content.path),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: content.blog.ui.breadcrumbBlog,
      item: absoluteUrl(blogHref),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: article.title,
    },
  ],
};
---

<PageLayout
  title={pageTitle}
  description={article.metaDescription}
  canonicalPath={routePath}
  routePath={routePath}
  lang={locale}
  alternates={alternates}
  openGraphType="article"
  openGraphImage={ogCoverPath}
  openGraphImageAlt={article.heroAlt}
  openGraphImageWidth={1200}
  openGraphImageHeight={630}
  openGraphImageType="image/png"
  authorName={authorName}
  articleMeta={{
    publishedTime: publishedIso,
    modifiedTime: modifiedIso,
    author: authorName,
    section: article.category,
  }}
  surface="muted"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <link slot="head" rel="preload" as="image" href={heroImage} fetchpriority="high" />
  <Header content={content} routePath={routePath} languageNav={languageNav} />

  <main class="article-page">
    <TableOfContents headings={headings} label={content.blog.ui.tableOfContents} />
    <div class="article-breadcrumb">
      <div class="article-breadcrumb-inner">
      <Breadcrumb
        items={[
          { label: content.blog.ui.breadcrumbHome, href: content.path },
          { label: content.blog.ui.breadcrumbBlog, href: locale === "en" ? "/blog/" : `/${locale}/blog/` },
          { label: article.title },
        ]}
        truncateLast={70}
      />
      </div>
    </div>
    <article id="article-top" class="article">
      <div class="article-header">
        <p class="article-category">{article.category}</p>
        <h1 class="article-title">{article.title}</h1>
        <p class="article-subtitle">{article.subtitle}</p>
        <div class="article-meta">
          <span>{authorName}</span>
          <span class="article-meta-dot">·</span>
          <time datetime={publishedIso}>{publishedDisplay}</time>
          <span class="article-meta-dot">·</span>
          <span>{article.readTime}</span>
        </div>
        <img
          src={heroImage}
          alt={article.heroAlt}
          class="article-hero-image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="article-body"><Content /></div>

      {article.faq && article.faq.length > 0 && (
        <section class="article-faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently Asked Questions</h2>
          <FaqAccordion items={article.faq} />
        </section>
      )}

      <section class="article-cta">
        <button type="button" class="btn-primary" data-modal-open data-from={`static-blog:${slug}`}>
          {content.cta.submit.label}
        </button>
      </section>

      <aside class="article-author">
        <div class="author-card">
          {authorObj.photoUrl && (
            <img src={authorObj.photoUrl} alt={authorName} class="author-photo" />
          )}
          <div class="author-body">
            <p class="author-name">{authorName}</p>
            {authorObj.role && <p class="author-role">{authorObj.role}</p>}
            {authorBioEntry && <p class="author-bio">{authorBioEntry.text}</p>}
            {authorObj.links && (authorObj.links.website || authorObj.links.linkedin || authorObj.links.twitter) && (
              <ul class="author-links">
                {authorObj.links.website && (
                  <li><a href={authorObj.links.website} rel="noopener nofollow">Website</a></li>
                )}
                {authorObj.links.linkedin && (
                  <li><a href={authorObj.links.linkedin} rel="noopener nofollow">LinkedIn</a></li>
                )}
                {authorObj.links.twitter && (
                  <li><a href={authorObj.links.twitter} rel="noopener nofollow">Twitter</a></li>
                )}
              </ul>
            )}
          </div>
        </div>
      </aside>

      <KeepReading posts={article.relatedPosts ?? []} title="Keep reading" />
    </article>
  </main>

  <Footer content={content} routePath={routePath} />
  <Modal content={content} />
</PageLayout>

<script define:vars={{ leadsUrl: `${siteConfig.leadsApiUrl}/leads`, applicationId: siteConfig.applicationId, toast: content.toast, turnstileEnabled: Boolean(siteConfig.turnstileSiteKey) }}>
  (() => {
    const modal = document.querySelector("[data-lead-modal]");
    const toastEl = document.querySelector("[data-lead-toast]");
    let toastTimer, lastFocused = null;

    const showToast = (message, isError) => {
      if (!toastEl) return;
      toastEl.textContent = message;
      toastEl.classList.toggle("lead-toast--error", Boolean(isError));
      toastEl.hidden = false;
      void toastEl.offsetWidth;
      toastEl.classList.add("lead-toast--visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toastEl.classList.remove("lead-toast--visible");
        setTimeout(() => { toastEl.hidden = true; }, 300);
      }, 4000);
    };

    const openModal = (from) => {
      if (!modal) return;
      const form = modal.querySelector("[data-lead-form]");
      if (form && from) form.setAttribute("data-from", from);
      lastFocused = document.activeElement;
      modal.hidden = false;
      void modal.offsetWidth;
      modal.classList.add("lead-modal--open");
      document.body.style.overflow = "hidden";
      const input = modal.querySelector("input");
      if (input) setTimeout(() => input.focus(), 50);
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.remove("lead-modal--open");
      document.body.style.overflow = "";
      setTimeout(() => { modal.hidden = true; }, 250);
      if (lastFocused && typeof lastFocused.focus === "function") lastFocused.focus();
    };

    document.querySelectorAll("[data-modal-open]").forEach((trigger) => {
      trigger.addEventListener("click", () => openModal(trigger.getAttribute("data-from")));
    });

    if (modal) {
      modal.querySelectorAll("[data-modal-close]").forEach((el) => {
        el.addEventListener("click", closeModal);
      });
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.hidden) closeModal();
    });

    const buildUtmMetadata = () => {
      const params = new URLSearchParams(window.location.search);
      return Object.fromEntries(Array.from(params.entries()).filter(([key]) => key.startsWith("utm_")));
    };

    const buildLeadMetadata = (from) => ({
      from,
      page: window.location.href,
      path: window.location.pathname,
      locale: document.documentElement.lang || "unknown",
      referrer: document.referrer,
      userAgent: navigator.userAgent,
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      utm: buildUtmMetadata(),
    });

    const getTurnstileToken = (form) => {
      const field = form.querySelector('[name="cf-turnstile-response"]');
      return field ? field.value : "";
    };

    const resetTurnstile = (form) => {
      if (!turnstileEnabled || typeof window.turnstile === "undefined") return;
      const widget = form.querySelector(".cf-turnstile");
      if (widget) window.turnstile.reset(widget);
    };

    document.querySelectorAll("[data-lead-form]").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const input = form.querySelector('input[type="email"]');
        const button = form.querySelector('button[type="submit"]');
        const email = input ? input.value.trim() : "";
        const from = form.getAttribute("data-from") || "unknown";
        if (!input || !input.checkValidity() || !email) { if (input) input.reportValidity(); return; }
        const turnstileToken = turnstileEnabled ? getTurnstileToken(form) : "";
        if (turnstileEnabled && !turnstileToken) { showToast(toast.error, true); return; }
        if (button) button.disabled = true;
        form.setAttribute("aria-busy", "true");
        try {
          const res = await fetch(leadsUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, applicationId, metadata: buildLeadMetadata(from), turnstileToken }),
          });
          if (!res.ok) throw new Error();
          if (input) input.value = "";
          if (modal && form.closest("[data-lead-modal]")) closeModal();
          showToast(toast.success, false);
        } catch {
          showToast(toast.error, true);
        } finally {
          resetTurnstile(form);
          if (button) button.disabled = false;
          form.removeAttribute("aria-busy");
        }
      });
    });
  })();
</script>

<style>
  .article-page {
    padding-top: 80px;
    background: transparent;
    min-height: 100vh;
  }

  .article {
    max-width: 1192px;
    margin: 0 auto;
    padding: 40px 24px 100px;
  }

  .article-breadcrumb {
    padding: 32px 24px 0;
  }

  .article-breadcrumb-inner {
    /* Breadcrumb starts on the same reading axis as the article title. */
    max-width: 860px;
    margin: 0 auto;
  }

  /* Header */
  .article-header {
    max-width: 860px;
    margin: 0 auto 40px;
  }

  .article-category {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--article-text-muted, #6B6B6B);
    margin: 0 0 20px;
  }

  .article-title {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--article-heading, #0E0E0E);
    margin: 0 0 16px;
  }

  .article-subtitle {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--article-text-secondary, #3D3D3D);
    margin: 0 0 24px;
  }

  .article-meta {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 14px;
    color: var(--article-text-muted, #6B6B6B);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .article-meta-dot {
    color: #B0B0B0;
  }

  .article-hero-image {
    display: block;
    width: 100%;
    max-width: 860px;
    aspect-ratio: 16 / 9;
    margin: 40px auto 0;
    object-fit: cover;
    border-radius: 20px;
  }

  .article-faq {
    max-width: 860px;
    margin: 64px auto 0;
    padding-top: 40px;
    border-top: 1px solid var(--article-border, #D5D5D5);
  }

  .article-faq h2 {
    font-family: 'Roboto Flex', sans-serif;
    font-size: clamp(26px, 3vw, 32px);
    line-height: 1.25;
    color: var(--article-heading, #0E0E0E);
    margin: 0 0 24px;
    text-align: center;
  }

  .article-cta {
    max-width: 860px;
    margin: 48px auto 0;
    text-align: center;
  }

  .article-author {
    max-width: 860px;
    margin: 60px auto 0;
    padding-top: 40px;
    border-top: 1px solid var(--article-border, #E8E8E8);
  }

  .author-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .author-photo {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-body { flex: 1; }

  .author-name {
    font-family: 'Roboto Flex', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: var(--article-heading, #0E0E0E);
    margin: 0 0 4px;
  }

  .author-role {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 14px;
    color: var(--article-text-muted, #6B6B6B);
    margin: 0 0 8px;
  }

  .author-bio {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 15px;
    color: var(--article-text-secondary, #3D3D3D);
    margin: 0 0 8px;
    line-height: 1.5;
  }

  .author-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .author-links a {
    color: var(--article-accent, #4C27E3);
    font-size: 13px;
    text-decoration: none;
  }

  /* Body */
  .article-body {
    max-width: 860px;
    margin: 0 auto;
  }

  /* Article body is injected via set:html, so its descendants are not
     touched by Astro's scoping — target them with :global(). */
  .article-body :global(p) {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--article-text, #1C1C1C);
    margin: 0 0 28px;
  }

  .article-body :global(h2) {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--article-heading, #0E0E0E);
    margin: 52px 0 16px;
  }

  .article-body :global(h3) {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--article-heading, #0E0E0E);
    margin: 36px 0 12px;
  }

  .article-body :global(strong) {
    font-weight: 600;
    color: var(--article-heading, #0E0E0E);
  }

  .article-body :global(em) {
    font-style: italic;
  }

  .article-body :global(a) {
    color: var(--article-accent, #4C27E3);
    text-decoration: underline;
    text-decoration-color: rgba(76, 39, 227, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .article-body :global(a:hover) {
    text-decoration-color: var(--article-accent, #4C27E3);
  }

  .article-body :global(button.btn-secondary) {
    border: none;
    cursor: pointer;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--article-border, #E8E8E8);
    margin: 40px 0;
  }

  .article-body :global(.sources-title) {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--article-text-muted, #6B6B6B);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 16px;
  }

  .article-body :global(.sources-list) {
    padding-left: 20px;
    margin: 0;
  }

  .article-body :global(.sources-list li) {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--article-text-muted, #6B6B6B);
    margin-bottom: 10px;
  }

  .article-body :global(.sources-list a) {
    color: var(--article-text-muted, #6B6B6B);
    font-size: 13px;
    word-break: break-all;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    font-family: 'Roboto Flex', sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--article-text, #1C1C1C);
    margin: 0 0 28px;
    padding-left: 28px;
  }

  .article-body :global(ul li),
  .article-body :global(ol li) {
    margin-bottom: 12px;
    padding-left: 6px;
  }

  .article-body :global(ul li:last-child),
  .article-body :global(ol li:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .article-breadcrumb {
      padding: 24px 20px 0;
    }

    .article {
      padding: 32px 20px 80px;
    }

    .article-title {
      font-size: 30px;
    }

    .article-subtitle {
      font-size: 18px;
    }

    .article-hero {
      margin-bottom: 40px;
    }

    .article-body :global(p) {
      font-size: 18px;
    }

    .article-body :global(h2) {
      font-size: 24px;
      margin-top: 40px;
    }

    .article-body :global(h3) {
      font-size: 20px;
    }
  }
</style>
