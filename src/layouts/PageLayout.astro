---
import { absoluteUrl, pageAssetUrl, siteConfig } from "../config/site";
import { brandTokens } from "@site/config/brand";
import TrackingScripts from "../components/TrackingScripts.astro";
import TurnstileScript from "../components/TurnstileScript.astro";
import "@site/styles/styles.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  routePath: string;
  lang?: string;
  baseHref?: string;
  robots?: string;
  alternates?: { hreflang: string; href: string }[];
  openGraphType?: "website" | "article";
  openGraphImage?: string;
  openGraphImageAlt?: string;
  openGraphImageWidth?: number;
  openGraphImageHeight?: number;
  openGraphImageType?: string;
  twitterCard?: "summary" | "summary_large_image";
  authorName?: string;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  surface?: "default" | "muted";
}

const {
  title,
  description,
  canonicalPath,
  routePath,
  lang = "en",
  baseHref,
  robots = "index, follow",
  alternates = [],
  openGraphType = "website",
  openGraphImage,
  openGraphImageAlt,
  openGraphImageWidth,
  openGraphImageHeight,
  openGraphImageType,
  twitterCard,
  authorName,
  articleMeta,
  surface = "default",
} = Astro.props;
const canonicalUrl = absoluteUrl(canonicalPath);
const openGraphImageUrl = absoluteUrl(openGraphImage ?? siteConfig.heroImagePath);
const resolvedTwitterCard = twitterCard ?? "summary_large_image";
const ogLocaleMap: Record<string, string> = {
  en: "en_US",
  uk: "uk_UA",
  es: "es_ES",
  de: "de_DE",
};
const ogLocale = ogLocaleMap[lang] ?? ogLocaleMap.en;
const scriptPath = pageAssetUrl(routePath, siteConfig.scriptPath);
const favicon = pageAssetUrl(routePath, brandTokens.faviconPath);
const faviconDark = pageAssetUrl(routePath, brandTokens.faviconDarkPath);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {baseHref && <base href={baseHref} />}
    <title>{title}</title>
    <TrackingScripts />
    <TurnstileScript />

    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={ogLocale} />
    {alternates
      .filter((alternate) => alternate.hreflang !== "x-default" && alternate.hreflang !== lang)
      .map((alternate) => ogLocaleMap[alternate.hreflang] && (
        <meta property="og:locale:alternate" content={ogLocaleMap[alternate.hreflang]} />
      ))}
    <meta property="og:image" content={openGraphImageUrl} />
    {openGraphImageWidth && <meta property="og:image:width" content={String(openGraphImageWidth)} />}
    {openGraphImageHeight && <meta property="og:image:height" content={String(openGraphImageHeight)} />}
    {openGraphImageType && <meta property="og:image:type" content={openGraphImageType} />}
    {openGraphImageAlt && <meta property="og:image:alt" content={openGraphImageAlt} />}
    {articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
    {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}
    {articleMeta?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {authorName && <meta name="author" content={authorName} />}
    <meta name="twitter:card" content={resolvedTwitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={openGraphImageUrl} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={brandTokens.themeColor} />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="icon" type="image/png" href={faviconDark} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={brandTokens.googleFontsUrl}
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <slot name="head" />
  </head>
  <body class:list={{ "page-surface--muted": surface === "muted" }}>
    <slot />
    <script src={scriptPath} defer></script>
  </body>
</html>

<style is:global>
  body.page-surface--muted {
    background: var(--article-bg, #F3F3F3);
  }

  a,
  button,
  input,
  textarea,
  select {
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

</style>
