---
import { absoluteUrl, pageAssetUrl, siteConfig } from "../config/site";
import SeoHead from "../components/SeoHead.astro";
import ThemeInit from "../components/ThemeInit.astro";
import TrackingScripts from "../components/TrackingScripts.astro";
import TurnstileScript from "../components/TurnstileScript.astro";
import "@site/styles/styles.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  routePath: string;
  lang?: string;
  baseHref?: string;
  robots?: string;
  alternates?: { hreflang: string; href: string }[];
  openGraphType?: "website" | "article";
  openGraphImage?: string;
  openGraphImageAlt?: string;
  openGraphImageWidth?: number;
  openGraphImageHeight?: number;
  openGraphImageType?: string;
  twitterCard?: "summary" | "summary_large_image";
  authorName?: string;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  surface?: "default" | "muted";
}

const {
  title,
  description,
  canonicalPath,
  routePath,
  lang = "en",
  baseHref,
  robots,
  alternates = [],
  openGraphType = "website",
  openGraphImage,
  openGraphImageAlt,
  openGraphImageWidth,
  openGraphImageHeight,
  openGraphImageType,
  twitterCard,
  authorName,
  articleMeta,
  surface = "default",
} = Astro.props;

const canonicalUrl = absoluteUrl(canonicalPath);
const openGraphImageUrl = absoluteUrl(openGraphImage ?? siteConfig.heroImagePath);
const ogLocaleMap: Record<string, string> = {
  en: "en_US",
  uk: "uk_UA",
  es: "es_ES",
  de: "de_DE",
};
const ogLocale = ogLocaleMap[lang] ?? ogLocaleMap.en;
const ogLocaleAlternates = alternates
  .filter((alternate) => alternate.hreflang !== "x-default" && alternate.hreflang !== lang)
  .map((alternate) => ogLocaleMap[alternate.hreflang])
  .filter((v): v is string => Boolean(v));
const scriptPath = pageAssetUrl(routePath, siteConfig.scriptPath);
---

<!doctype html>
<html lang={lang}>
  <head>
    {baseHref && <base href={baseHref} />}
    <TrackingScripts />
    <TurnstileScript />
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      routePath={routePath}
      lang={lang}
      robots={robots}
      alternates={alternates}
      openGraphType={openGraphType}
      openGraphImage={openGraphImageUrl}
      openGraphImageAlt={openGraphImageAlt}
      openGraphImageWidth={openGraphImageWidth}
      openGraphImageHeight={openGraphImageHeight}
      openGraphImageType={openGraphImageType}
      openGraphLocale={ogLocale}
      openGraphLocaleAlternates={ogLocaleAlternates}
      twitterCard={twitterCard}
      authorName={authorName}
      articleMeta={articleMeta}
    />
    <slot name="head" />
    <ThemeInit />
  </head>
  <body class:list={{ "page-surface--muted": surface === "muted" }}>
    <slot />
    <script src={scriptPath} defer></script>
  </body>
</html>

<style is:global>
  body.page-surface--muted {
    background: var(--article-bg, #F3F3F3);
  }

  a,
  button,
  input,
  textarea,
  select {
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

</style>
